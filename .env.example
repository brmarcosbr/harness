# Provedor padrão: gemini, deepseek ou openai
HARNESS_PROVIDER=gemini

# Chaves de API para os provedores suportados
GEMINI_API_KEY=sua_chave_gemini_aqui
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# Configurações opcionais de modelo e endpoint customizado
# HARNESS_MODELO=gemini-2.5-flash
# HARNESS_BASE_URL=https://api.deepseek.com

# Esforço de raciocínio e teto de tokens de saída enviados ao endpoint compatível com OpenAI.
# Padrões: high e 65536 (o teto é o default do servidor em modo thinking; fixá-lo impede que
# ele ande sozinho junto com o esforço). Valores de esforço aceitos: low, high, max — 'medium'
# e 'xhigh' são aliases que resolvem para high. Valor inválido é ignorado com aviso em stderr.
# HARNESS_REASONING_EFFORT=high
# HARNESS_MAX_TOKENS=65536
